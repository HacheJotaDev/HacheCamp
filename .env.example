# ============================================================ #
# HJ Campaigns — plantilla de configuración                    #
# Copia este archivo a .env y rellena los valores:             #
#   cp .env.example .env && nano .env                          #
# NUNCA subas el .env real al repositorio.                     #
# ============================================================ #

# --- Aplicación ------------------------------------------------------------
ENV=production
# Genera una clave con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTO_POR_64_CARACTERES_ALEATORIOS_MINIMO_32

# --- Base de datos y Redis (nombres internos de la red Docker) --------------
# La contraseña de DATABASE_URL debe ser EXACTAMENTE la misma que POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://hj:CAMBIA_ESTA_CLAVE@postgres:5432/hj_campaigns
POSTGRES_DB=hj_campaigns
POSTGRES_USER=hj
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE
REDIS_URL=redis://redis:6379/0

# --- Puertos y vinculación ---------------------------------------------------
# BIND_IP=127.0.0.1 -> solo acceso local (recomendado en la puesta en marcha;
# administra con túnel SSH: ssh -L 8085:127.0.0.1:8085 vps)
# BIND_IP=0.0.0.0 -> acceso público directo (SOLO detrás de un proxy inverso HTTPS)
BIND_IP=127.0.0.1
PORT_FRONTEND=8085
PORT_API=8086

# --- Sesiones y seguridad -----------------------------------------------------
# false SOLO en pruebas locales sin HTTPS
COOKIE_SECURE=true
SESSION_TTL_MINUTES=480
LOGIN_MAX_ATTEMPTS_EMAIL=5
LOGIN_MAX_ATTEMPTS_IP=20
LOGIN_LOCK_MINUTES=15
MFA_REQUIRED_FOR_ADMIN=true
PASSWORD_MIN_LENGTH=12
ALLOWED_ORIGINS=

# --- Amazon SES ---------------------------------------------------------------
AWS_REGION=us-east-2
# Credenciales (elige UNA forma):
#   a) RECOMENDADA en el VPS: archivo /root/.aws/credentials (usuario IAM
#      ses-vps-leisureparts). scripts/deploy.sh lo monta como secreto Docker
#      de solo lectura; aquí no hace falta nada.
#   b) Variables de entorno: rellena las dos siguientes (déjalas vacías o
#      comenta las líneas si usas la forma a).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Perfil del archivo de credenciales (por defecto "default")
AWS_PROFILE=default
# Opcional: conjunto de configuración y lista de contactos de SES
SES_CONFIGURATION_SET=
SES_CONTACT_LIST=
SES_MAX_PER_SECOND=

# --- Eventos de SES por SQS (canal privado) -----------------------------------
# Rellena AWS_SQS_EVENTS_QUEUE_URL tras ejecutar:
#   docker compose exec -T api python scripts/setup_ses_events.py --aplicar
# Con SQS no necesitas ningún endpoint HTTP público para recibir rebotes/quejas.
AWS_SQS_EVENTS_QUEUE_URL=
# Verificar la firma criptográfica del sobre SNS (recomendado: true)
SQS_VERIFY_SNS_SIGNATURE=true
# Mensaje venenoso: se descarta tras N lecturas (además de la DLQ)
SQS_MAX_RECEIVE_COUNT=5

# --- URLs públicas ------------------------------------------------------------
# URL con la que los destinatarios abren el panel y los enlaces de baja
PUBLIC_BASE_URL=http://169.58.36.6:8085
# URL del API usada en cabeceras List-Unsubscribe (un clic) y seguimiento de clics
API_BASE_URL=http://169.58.36.6:8085
# Token secreto de la URL del webhook SNS (alternativa a SQS, requiere HTTPS)
# Genera: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_TOKEN=
# Lista blanca opcional de tópicos SNS separados por comas (verificación SQS/webhook)
SNS_TOPIC_ARNS=

# --- Envío --------------------------------------------------------------------
SEND_RATE_PER_SECOND=5
RETRY_BACKOFF_SECONDS=60
RETRY_MAX_ATTEMPTS=4
STALE_SENDING_MINUTES=10

# --- Cargas y logs ------------------------------------------------------------
CSV_MAX_MB=5
LOG_LEVEL=INFO
LOG_JSON=true
