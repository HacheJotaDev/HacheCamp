# ============================================================ #
# HJ Campaigns — plantilla de configuración                    #
# Copia este archivo a .env y rellena los valores:             #
#   cp .env.example .env && nano .env                          #
# NUNCA subas el .env real al repositorio.                     #
# ============================================================ #

# --- Aplicación ------------------------------------------------------------
ENV=production
# Genera una clave con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTO_POR_64_CARACTERES_ALEATORIOS_MINIMO_32

# --- Base de datos y Redis (nombres internos de la red Docker) --------------
DATABASE_URL=postgresql+psycopg://hj:CAMBIA_ESTA_CLAVE@postgres:5432/hj_campaigns
POSTGRES_DB=hj_campaigns
POSTGRES_USER=hj
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE
REDIS_URL=redis://redis:6379/0

# --- Puertos y vinculación ---------------------------------------------------
# BIND_IP=127.0.0.1  -> solo acceso local (recomendado durante la puesta en marcha;
#                       usa un túnel SSH para administrar: ssh -L 8085:127.0.0.1:8085 vps)
# BIND_IP=0.0.0.0    -> acceso público directo (SOLO detrás de un proxy inverso HTTPS)
BIND_IP=127.0.0.1
PORT_FRONTEND=8085
PORT_API=8086

# --- Sesiones y seguridad -----------------------------------------------------
COOKIE_SECURE=true              # false SOLO en pruebas locales sin HTTPS
SESSION_TTL_MINUTES=480
LOGIN_MAX_ATTEMPTS_EMAIL=5
LOGIN_MAX_ATTEMPTS_IP=20
LOGIN_LOCK_MINUTES=15
MFA_REQUIRED_FOR_ADMIN=true
PASSWORD_MIN_LENGTH=12
ALLOWED_ORIGINS=

# --- Amazon SES ---------------------------------------------------------------
AWS_REGION=us-east-2
# Credenciales del usuario IAM ses-vps-leisureparts (permisos solo SES).
# NO uses credenciales de root. Rótalas periódicamente.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcional: conjunto de configuración y lista de contactos de SES
SES_CONFIGURATION_SET=
SES_CONTACT_LIST=
SES_MAX_PER_SECOND=

# --- URLs públicas ------------------------------------------------------------
# URL con la que los destinatarios abren el panel y los enlaces de baja
PUBLIC_BASE_URL=http://169.58.36.6:8085
# URL del API usada en cabeceras List-Unsubscribe (una clic) y seguimiento de clics
API_BASE_URL=http://169.58.36.6:8085
# Token secreto de la URL del webhook SNS (python3 -c "import secrets; print(secrets.token_urlsafe(32))")
WEBHOOK_TOKEN=
# Lista blanca opcional de tópicos SNS separados por comas
SNS_TOPIC_ARNS=

# --- Envío --------------------------------------------------------------------
SEND_RATE_PER_SECOND=5
RETRY_BACKOFF_SECONDS=60
RETRY_MAX_ATTEMPTS=4
STALE_SENDING_MINUTES=10

# --- Cargas y logs ------------------------------------------------------------
CSV_MAX_MB=5
LOG_LEVEL=INFO
LOG_JSON=true
